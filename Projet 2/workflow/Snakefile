# =============================================================================
# Workflow Projet 2 : téléchargement -> Trimmomatic -> index Salmon -> salmon quant
# Lancement : ./run.sh   (depuis le dossier "Projet 2")
# =============================================================================
import pandas as pd

configfile: "config/config.yaml"

SAMPLES = pd.read_csv(config["samples"], sep="\t")["sample"].tolist()

# --- Référence : un chromosome (test) ou le génome complet -------------------
CHROM = str(config["chromosome"]).strip()
BASE = config["ensembl"]["base"]
if CHROM:
    REF = f"chr{CHROM}"
    GENOME_URL = f"{BASE}/fasta/mus_musculus/dna/Mus_musculus.GRCm38.dna.chromosome.{CHROM}.fa.gz"
    GFF_URL = f"{BASE}/gff3/mus_musculus/Mus_musculus.GRCm38.100.chromosome.{CHROM}.gff3.gz"
else:
    REF = "complet"
    GENOME_URL = f"{BASE}/fasta/mus_musculus/dna/Mus_musculus.GRCm38.dna.toplevel.fa.gz"
    GFF_URL = f"{BASE}/gff3/mus_musculus/Mus_musculus.GRCm38.100.gff3.gz"

# --- Lectures : sous-échantillon (test) ou totalité ---------------------------
# Le nom du dossier dépend du sous-échantillonnage pour ne jamais mélanger
# des lectures de test avec des lectures complètes.
MAX_SPOTS = int(config["max_spots"])
LECTURES = f"sub{MAX_SPOTS}" if MAX_SPOTS > 0 else "complet"

include: "regles/telechargement.smk"
include: "regles/trimming.smk"
include: "regles/index.smk"
include: "regles/quantification.smk"

rule all:
    input:
        expand("results/salmon/{ref}_{lect}/{srr}/quant.sf", ref=REF, lect=LECTURES, srr=SAMPLES)
